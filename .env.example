# ============================================================================
# CloudGuard Gemma Agent — Environment Configuration
# ============================================================================

# Google Cloud Project Settings
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"

# Gemma Inference Backend Mode: "local_ollama" | "cloud_run_vllm" | "vertex_ai"
GEMMA_BACKEND_MODE="local_ollama"

# Local Prototyping (Part 1 & Part 2) via Ollama or Docker Model Runner
OLLAMA_API_BASE="http://localhost:11434"
GEMMA_MODEL_NAME="ollama_chat/gemma3:27b"

# Production Cloud Run GPU vLLM Endpoint (Part 3 & Part 4)
# Deployed with --no-allow-unauthenticated and invoked via IAM Identity Token
GEMMA_VLLM_ENDPOINT_URL="https://gemma-vllm-service-xyz-uc.a.run.app/v1"
GEMMA_VLLM_MODEL_ID="google/gemma-3-27b-it"

# Firestore Configuration (Part 2)
FIRESTORE_DATABASE="(default)"
USE_LOCAL_MOCK_DB="true"

# Governance & Security Settings (Part 4)
ENABLE_MODEL_ARMOR_GUARDRAILS="true"
MAX_AUTO_MITIGATION_COST_USD="500.0"
